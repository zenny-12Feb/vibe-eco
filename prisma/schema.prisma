generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING_PAYMENT // Cho thanh toan
  PAID // Da thanh toan
  PROCESSING // Dang chuan bi hang
  SHIPPING // Dang giao hang
  COMPLETED // Hoan thanh
  CANCELLED // Da huy
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  price       Int // VND, gia ban/item, so nguyen
  costPrice   Int      @default(0) // VND, gia von/block
  imageUrl    String   @default("")
  category    String   @default("Khac")
  stock       Int      @default(100) // so luong block/goi con trong kho
  itemsPerBlock Int    @default(1) // so luong item trong moi block/goi
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]
}

model Order {
  id              String      @id @default(uuid())
  code            String      @unique // ma don hang hien thi cho khach, vd DH-A1B2C3
  customerName    String
  customerPhone   String
  customerAddress String      @default("")
  note            String      @default("")
  totalAmount     Int
  status          OrderStatus @default(PENDING_PAYMENT)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items OrderItem[]
}

model OrderItem {
  id          String  @id @default(uuid())
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId   String?
  productName String // snapshot ten san pham tai thoi diem mua
  price       Int // snapshot gia tai thoi diem mua
  quantity    Int
}

model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
